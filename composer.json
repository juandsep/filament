{
    "name": "vibefilter/filament",
    "description": "Filter your Filament tables by vibe: natural-language table filters powered by TypeSafe Jev.",
    "keywords": ["filament", "filament-plugin", "laravel", "jev", "typesafe", "ai", "natural-language", "filter"],
    "homepage": "https://vibefilter.dev",
    "license": "MIT",
    "require": {
        "php": "^8.2",
        "filament/filament": "^5.0",
        "spatie/laravel-package-tools": "^1.16"
    },
    "require-dev": {
        "orchestra/testbench": "^11.0",
        "phpunit/phpunit": "^12.0"
    },
    "autoload": {
        "psr-4": {
            "Vibefilter\\Filament\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Vibefilter\\Filament\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "extra": {
        "laravel": {
            "providers": [
                "Vibefilter\\Filament\\VibefilterServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
