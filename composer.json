{
    "name": "vibefilter/filament",
    "description": "Filter your Filament tables by vibe: natural-language table filters powered by TypeSafe Jev.",
    "keywords": [
        "filament",
        "filament-plugin",
        "laravel",
        "jev",
        "typesafe",
        "ai",
        "natural-language",
        "filter"
    ],
    "homepage": "https://vibefilter.dev",
    "license": "MIT",
    "require": {
        "php": "^8.2",
        "filament/filament": "^5.1",
        "illuminate/http": "^12.36|^13.0",
        "spatie/laravel-package-tools": "^1.16"
    },
    "require-dev": {
        "larastan/larastan": "^3.12",
        "laravel/pint": "^1.32",
        "orchestra/testbench": "^10.0|^11.0",
        "phpunit/phpunit": "^11.0|^12.0"
    },
    "autoload": {
        "psr-4": {
            "Vibefilter\\Filament\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Vibefilter\\Filament\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "lint": "pint",
        "test:lint": "pint --test",
        "analyse": "phpstan analyse"
    },
    "extra": {
        "laravel": {
            "providers": [
                "Vibefilter\\Filament\\VibefilterServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
